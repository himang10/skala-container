# 1단계: Vue 프로젝트를 빌드해서 정적 파일(dist/)을 생성한다.
# (03.frontend와 달리 Vue는 빌드 과정이 필요하므로 멀티스테이지 빌드를 사용한다)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

# 2단계: 빌드된 정적 파일만 nginx 이미지에 담아 서빙한다.
FROM nginx:alpine

# 여기에 builder stage에서 생성한 Html, CSS, JS Static Resource를 
# default.conf에서 설정하고 있는 /usr/share/nginx/html 아래 복사하기

# nginx 실행 (기본 CMD가 이미 설정되어 있음)
CMD ["nginx", "-g", "daemon off;"]
