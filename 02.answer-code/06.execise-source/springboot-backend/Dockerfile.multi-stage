# ==============================================================
# Multi-stage Dockerfile
#
# Stage 1 (builder): Dockerfile.ubuntu 기반
#   → ubuntu:24.04 + openjdk-21-jdk + Maven 으로 소스 컴파일
#
# Stage 2 (runtime): Dockerfile.jdk21 기반
#   → eclipse-temurin:25-jre 에 jar만 복사하여 최소 이미지 생성
#
# 효과: 빌드 도구(JDK, Maven, 소스코드)가 최종 이미지에 포함되지 않음
# ==============================================================

# ---------------------------------------------------------------
# Stage 1: Build — ubuntu:24.04 + openjdk-21-jdk + Maven
# ---------------------------------------------------------------
FROM ubuntu:24.04 AS builder

RUN apt-get update && apt-get install -y openjdk-21-jdk maven \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# pom.xml 먼저 복사 → 의존성 레이어 캐시 (소스 변경 시 재다운로드 방지)
COPY pom.xml .
RUN mvn dependency:go-offline -q

# 소스 전체 복사 후 빌드 (-DskipTests: 테스트 제외)
# mvn package      : 컴파일 + 패키징 (Docker 빌드에 적합, local repo 설치 안 함)
# mvn clean install: package와 동일하나 ~/.m2 에도 설치 (불필요한 단계 포함)
COPY src ./src
RUN mvn package -DskipTests -q

# ---------------------------------------------------------------
# Stage 2: Runtime — eclipse-temurin:25-jre (최종 이미지)
# ---------------------------------------------------------------
FROM eclipse-temurin:25-jre

WORKDIR /app

ENV SPRING_PROFILES_ACTIVE=local

# builder 스테이지의 jar만 복사 (소스, JDK, Maven 캐시 제외)
COPY --from=builder /build/target/*.jar app.jar

ENTRYPOINT ["java", "-jar", "app.jar"]
